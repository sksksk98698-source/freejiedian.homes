---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import { airportsData, type AirportBrand, siteBrand } from '../../data/airports';

export function getStaticPaths() {
  return airportsData.map((airport) => ({
    params: { slug: airport.slug },
    props: { airport },
  }));
}

interface Props {
  airport: AirportBrand;
}

const { airport } = Astro.props;

const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: `${airport.name} 网络加速服务`,
  description: airport.summary,
  brand: {
    '@type': 'Brand',
    name: airport.name,
  },
  offers: {
    '@type': 'Offer',
    priceCurrency: 'CNY',
    price: airport.price.replace(/[^0-9.]/g, '') || '15',
    availability: 'https://schema.org/InStock',
    url: airport.affUrl,
  },
  review: {
    '@type': 'Review',
    author: { '@type': 'Organization', name: siteBrand.name },
    datePublished: '2026-10-19',
    reviewRating: {
      '@type': 'Rating',
      ratingValue: airport.isTopChoice ? '4.9' : airport.isTop10 ? '4.8' : '4.6',
      bestRating: '5',
    },
    reviewBody: airport.detailText,
  }
};
---

<BaseLayout
  title={`${airport.name} 2026评测与测速大图 — 节点延迟、套餐价格与优惠码【免费节点】`}
  description={`${airport.name}深度实测报告：包含线路架构（${airport.lineType}）、协议支持（${airport.protocol}）、流媒体与ChatGPT解锁实测、套餐价格及专属优惠码。`}
  schema={productSchema}
>
  <!-- 详情头部 -->
  <article class="shell airport-detail-wrap" data-reveal>
    <div class="breadcrumb-nav">
      <a href="/">首页</a> &gt; <a href="/airports">机场品牌库</a> &gt; <span>{airport.name}</span>
    </div>

    <header class="detail-hero-card">
      <div class="detail-header-left">
        <div class="hero-badges-row">
          <span class="rank-tag">全库推荐 #{airport.rank}</span>
          {airport.isTopChoice && <span class="tag-top">🥇 本站第一主推</span>}
          {airport.hasSpeedtest && <span class="tag-verified">✔ 具备实测大图证据</span>}
        </div>
        <h1>{airport.name} · 深度测评与使用指南</h1>
        <p class="hero-summary-text">{airport.summary}</p>
        
        <div class="quick-meta-grid">
          <div class="meta-box">
            <span class="m-label">参考入门价格</span>
            <strong class="m-val color-red">{airport.price}</strong>
          </div>
          <div class="meta-box">
            <span class="m-label">线路架构</span>
            <strong class="m-val">{airport.lineType}</strong>
          </div>
          <div class="meta-box">
            <span class="m-label">支持协议</span>
            <strong class="m-val">{airport.protocol}</strong>
          </div>
          {airport.coupon && (
            <div class="meta-box coupon-box">
              <span class="m-label">专属折扣码</span>
              <strong class="m-val coupon-text">{airport.coupon}</strong>
            </div>
          )}
        </div>
      </div>

      <div class="detail-header-cta-panel">
        <div class="cta-inner-card">
          <div class="cta-price-highlight">
            <small>当前官方特惠通道</small>
            <strong>{airport.name} 官网</strong>
          </div>
          <a
            class="button button-primary btn-large"
            href={airport.affUrl}
            target="_blank"
            rel="nofollow sponsored noopener"
          >
            直达 {airport.name} 官网注册
            <Icon name="arrow-up-right" size={17} />
          </a>
          <small class="disclaimer-mini">
            * 提示：通过上方安全专属链接注册可享受专属线路与节点权益。
          </small>
        </div>
      </div>
    </header>

    <!-- 主体评测网格 -->
    <div class="detail-body-grid">
      <!-- 左侧内容主体 -->
      <section class="detail-main-content">
        <!-- 核心特性卡片 -->
        <div class="content-panel">
          <h2>一、核心特性与评测概述</h2>
          <div class="panel-prose">
            <p>
              <strong>{airport.name}</strong> 属于 2026 年综合表现极具代表性的网络加速服务品牌。基于多轮环境测试，其线路在日常跨国访问与晚高峰繁忙时段表现出优异的网络响应。
            </p>
            <div class="highlight-callout">
              <strong>💡 关键评估亮点：</strong>
              <ul>
                <li><strong>AI 解锁能力：</strong>{airport.aiSupport}</li>
                <li><strong>流媒体与娱乐：</strong>{airport.streamSupport}</li>
                <li><strong>协议与客户端：</strong>完美支持 Clash Verge Rev、v2rayN/v2rayNG、Shadowrocket（小火箭）等全平台一键导入。</li>
              </ul>
            </div>
          </div>
        </div>

        <!-- 真实测速证据展示区 (纯原图呈现) -->
        {airport.hasSpeedtest && (
          <div class="content-panel speedtest-evidence-panel">
            <div class="panel-header-with-badge">
              <h2>二、晚高峰真实节点测速大图证据</h2>
              <span class="evidence-pill">实测留存凭证</span>
            </div>
            <p class="evidence-intro">
              为保证客观公正，本站直接公开测试机器人生成的原始测速大图。截图展示了各节点在测试环境下的下载带宽、延迟与丢包率表现：
            </p>

            <div class="evidence-images-container">
              {airport.speedtestImages.map((imgSrc, idx) => (
                <figure class="evidence-figure">
                  <a href={imgSrc} target="_blank" rel="noopener noreferrer" title="点击查看高清大图">
                    <img
                      src={imgSrc}
                      alt={`${airport.name} 节点测速实测证据大图 #${idx + 1}`}
                      class="full-evidence-image"
                      loading="lazy"
                    />
                  </a>
                  <figcaption>
                    <span>📷 实测图 #{idx + 1}</span>
                    <small>点击图片可在新窗口查阅原始 1122×1402 高清分辨率大图与时间水印</small>
                  </figcaption>
                </figure>
              ))}
            </div>
          </div>
        )}

        <!-- 详细官方资料展开 -->
        <div class="content-panel">
          <h2>三、官方详细参数与配置档案</h2>
          <div class="raw-data-block">
            <pre><code>{airport.detailText}</code></pre>
          </div>
        </div>

        <!-- 适合人群与选购建议 -->
        <div class="content-panel">
          <h2>四、适合人群与使用建议</h2>
          <div class="advice-grid">
            <div class="advice-card good">
              <h3>👍 适合场景</h3>
              <ul>
                <li>经常需要使用 ChatGPT、Claude、Midjourney 等 AI 工具进行重度内容生产</li>
                <li>追求 4K Netflix、YouTube Premium、Disney+ 等超清流媒体不卡顿播放</li>
                <li>外贸独立站运营、跨境电商买家卖家以及对多设备支持有需求的用户</li>
              </ul>
            </div>
            <div class="advice-card notice">
              <h3>⚠️ 选购注意事项</h3>
              <ul>
                <li>建议首次购入优先选择「月付」或「轻量体验套餐」，亲自验证本地宽带在晚高峰的连接稳定性。</li>
                <li>注意妥善保管订阅链接，切勿在公共网络或不可信设备上泄露节点配置。</li>
              </ul>
            </div>
          </div>
        </div>
      </section>

      <!-- 右侧侧边栏悬挂导航 -->
      <aside class="detail-sidebar">
        <div class="sidebar-sticky-box">
          <div class="sidebar-brand-card">
            <span class="brand-sub">品牌导航</span>
            <h3>{airport.name}</h3>
            <p class="price-side-tag">入门价：{airport.price}</p>
            {airport.coupon && (
              <div class="sidebar-coupon">
                <span>优惠码：</span>
                <code>{airport.coupon}</code>
              </div>
            )}
            <a
              class="button button-primary btn-block"
              href={airport.affUrl}
              target="_blank"
              rel="nofollow sponsored noopener"
            >
              前往官网注册购买
              <Icon name="arrow-up-right" size={15} />
            </a>
          </div>

          
          <!-- 反向回链：深度技术专题研报 -->
          <div class="sidebar-box" style="background: var(--paper); border: 1px solid var(--line); border-radius: 18px; padding: 1.5rem; margin-bottom: 20px;">
            <h4 style="margin: 0 0 10px 0; font-size: 1rem;">📚 关联技术研报与避坑</h4>
            <div style="display: flex; flex-direction: column; gap: 8px; font-size: 0.82rem;">
              <a href="/topics/cheap-reliable-airports" style="color: var(--ink); text-decoration: none;">• 2026 平价高性价比选购指南</a>
              <a href="/topics/streaming-and-ai-unlocking" style="color: var(--ink); text-decoration: none;">• ChatGPT 与 4K 流媒体解锁实测</a>
              <a href="/topics/iepl-iplc-dedicated-lines" style="color: var(--ink); text-decoration: none;">• IEPL 与 IPLC 纯专线原理解析</a>
            </div>
          </div>

          <div class="sidebar-clients-card">
            <h4>推荐客户端下载</h4>
            <p>搭配以下客户端使用，导入订阅更轻松：</p>
            <ul class="client-mini-list">
              <li><a href="/clients">Windows: Clash Verge Rev</a></li>
              <li><a href="/clients">Android: v2rayNG</a></li>
              <li><a href="/clients">iOS: Shadowrocket (小火箭)</a></li>
              <li><a href="/clients">macOS: Clash Verge</a></li>
            </ul>
          </div>

          <div class="sidebar-other-ranks">
            <h4>其他高评分机场</h4>
            <div class="mini-links-list">
              {airportsData.filter(a => a.slug !== airport.slug).slice(0, 5).map((other) => (
                <a href={`/airports/${other.slug}`} class="other-item">
                  <span class="o-name">#{other.rank} {other.name}</span>
                  <span class="o-price">{other.price}</span>
                </a>
              ))}
            </div>
          </div>
        </div>
      </aside>
    </div>
  </article>
</BaseLayout>

<style>
  .airport-detail-wrap {
    padding-top: 2.5rem;
    padding-bottom: 5rem;
  }
  .breadcrumb-nav {
    font-size: 0.85rem;
    color: var(--muted);
    margin-bottom: 1.5rem;
    display: flex;
    gap: 8px;
    align-items: center;
  }
  .breadcrumb-nav a {
    color: var(--muted);
    text-decoration: none;
  }
  .breadcrumb-nav a:hover {
    color: #7157ff;
  }

  /* 头部 Hero 卡片 */
  .detail-hero-card {
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: 2rem;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 24px;
    padding: 2.5rem;
    margin-bottom: 2.5rem;
  }
  .hero-badges-row {
    display: flex;
    gap: 8px;
    margin-bottom: 12px;
    flex-wrap: wrap;
  }
  .rank-tag {
    font-size: 0.75rem;
    font-weight: 700;
    background: var(--paper-light);
    border: 1px solid var(--line);
    padding: 2px 10px;
    border-radius: 100px;
    color: var(--muted);
  }
  .tag-top {
    background: #f5c84c;
    color: #111016;
    font-size: 0.75rem;
    font-weight: 800;
    padding: 2px 10px;
    border-radius: 100px;
  }
  .tag-verified {
    background: rgba(116, 226, 208, 0.15);
    color: #20bca5;
    font-size: 0.75rem;
    font-weight: 700;
    padding: 2px 10px;
    border-radius: 100px;
  }
  .detail-hero-card h1 {
    font-size: 2.2rem;
    line-height: 1.25;
    margin: 0 0 12px 0;
  }
  .hero-summary-text {
    font-size: 1rem;
    color: var(--muted);
    line-height: 1.6;
    margin-bottom: 20px;
  }
  .quick-meta-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
  }
  .meta-box {
    background: var(--paper-light);
    border-radius: 12px;
    padding: 10px 14px;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .m-label {
    font-size: 0.72rem;
    color: var(--muted);
  }
  .m-val {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--ink);
  }
  .color-red {
    color: #ff6542 !important;
  }
  .coupon-box {
    border: 1px dashed #7157ff;
  }
  .coupon-text {
    color: #7157ff;
    font-family: monospace;
    font-size: 1.05rem;
  }

  /* 头部 CTA 侧栏 */
  .detail-header-cta-panel {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .cta-inner-card {
    background: linear-gradient(135deg, rgba(113, 87, 255, 0.08) 0%, rgba(116, 226, 208, 0.05) 100%);
    border: 1px solid rgba(113, 87, 255, 0.2);
    border-radius: 18px;
    padding: 2rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .cta-price-highlight small {
    display: block;
    font-size: 0.8rem;
    color: var(--muted);
  }
  .cta-price-highlight strong {
    font-size: 1.4rem;
    color: #7157ff;
  }
  .btn-large {
    font-size: 1rem;
    min-height: 48px;
    justify-content: center;
  }
  .disclaimer-mini {
    font-size: 0.72rem;
    color: var(--muted);
    line-height: 1.4;
  }

  /* 主体双栏布局 */
  .detail-body-grid {
    display: grid;
    grid-template-columns: 1fr 340px;
    gap: 2.5rem;
    align-items: flex-start;
  }
  .detail-main-content {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }
  .content-panel {
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 20px;
    padding: 2rem;
  }
  .content-panel h2 {
    font-size: 1.45rem;
    margin: 0 0 1.25rem 0;
  }
  .panel-header-with-badge {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
  }
  .evidence-pill {
    background: #20bca5;
    color: #fff;
    font-size: 0.72rem;
    padding: 3px 8px;
    border-radius: 4px;
    font-weight: 700;
  }
  .evidence-intro {
    font-size: 0.92rem;
    color: var(--muted);
    line-height: 1.6;
    margin-bottom: 1.5rem;
  }
  .highlight-callout {
    background: var(--paper-light);
    border-left: 4px solid #7157ff;
    padding: 1rem 1.25rem;
    border-radius: 0 12px 12px 0;
    margin-top: 1rem;
  }
  .highlight-callout ul {
    margin: 8px 0 0 0;
    padding-left: 20px;
    line-height: 1.7;
    font-size: 0.9rem;
  }

  /* 测速图片展示 */
  .evidence-images-container {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .evidence-figure {
    margin: 0;
    border: 1px solid var(--line);
    border-radius: 14px;
    overflow: hidden;
    background: #111016;
  }
  .full-evidence-image {
    width: 100%;
    max-height: 700px;
    object-fit: contain;
    display: block;
    background: #181620;
    transition: opacity 0.2s ease;
  }
  .full-evidence-image:hover {
    opacity: 0.95;
  }
  .evidence-figure figcaption {
    padding: 10px 16px;
    background: var(--paper-light);
    border-top: 1px solid var(--line);
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.8rem;
    color: var(--muted);
  }

  /* 原始代码块 */
  .raw-data-block pre {
    background: #111016;
    color: #f5f0e8;
    padding: 1.25rem;
    border-radius: 12px;
    font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
    font-size: 0.82rem;
    line-height: 1.6;
    overflow-x: auto;
    white-space: pre-wrap;
  }

  /* 选购建议 */
  .advice-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }
  .advice-card {
    padding: 1.25rem;
    border-radius: 14px;
    border: 1px solid var(--line);
  }
  .advice-card.good {
    background: rgba(32, 188, 165, 0.05);
    border-color: rgba(32, 188, 165, 0.2);
  }
  .advice-card.notice {
    background: rgba(255, 101, 66, 0.05);
    border-color: rgba(255, 101, 66, 0.2);
  }
  .advice-card h3 {
    margin: 0 0 10px 0;
    font-size: 1.1rem;
  }
  .advice-card ul {
    margin: 0;
    padding-left: 20px;
    font-size: 0.86rem;
    line-height: 1.6;
    color: var(--ink);
  }

  /* 侧栏样式 */
  .sidebar-sticky-box {
    position: sticky;
    top: 100px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .sidebar-brand-card,
  .sidebar-clients-card,
  .sidebar-other-ranks {
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 18px;
    padding: 1.5rem;
  }
  .brand-sub {
    font-size: 0.72rem;
    color: var(--muted);
    text-transform: uppercase;
  }
  .sidebar-brand-card h3 {
    margin: 4px 0 8px 0;
    font-size: 1.35rem;
  }
  .price-side-tag {
    font-size: 0.9rem;
    color: #ff6542;
    font-weight: 700;
    margin-bottom: 12px;
  }
  .sidebar-coupon {
    font-size: 0.8rem;
    margin-bottom: 14px;
  }
  .sidebar-coupon code {
    background: rgba(113, 87, 255, 0.12);
    color: #7157ff;
    padding: 2px 8px;
    border-radius: 4px;
    font-weight: 700;
  }
  .btn-block {
    width: 100%;
    justify-content: center;
  }
  .sidebar-clients-card h4,
  .sidebar-other-ranks h4 {
    margin: 0 0 10px 0;
    font-size: 1rem;
  }
  .sidebar-clients-card p {
    font-size: 0.8rem;
    color: var(--muted);
    margin-bottom: 10px;
  }
  .client-mini-list {
    margin: 0;
    padding-left: 18px;
    font-size: 0.82rem;
    line-height: 1.8;
  }
  .client-mini-list a {
    color: #7157ff;
    text-decoration: none;
  }
  .mini-links-list {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .other-item {
    display: flex;
    justify-content: space-between;
    font-size: 0.82rem;
    color: var(--ink);
    text-decoration: none;
    padding: 6px 0;
    border-bottom: 1px solid var(--line);
  }
  .other-item:hover {
    color: #7157ff;
  }
  .o-price {
    color: var(--muted);
    font-size: 0.75rem;
  }

  @media (max-width: 900px) {
    .detail-hero-card {
      grid-template-columns: 1fr;
    }
    .detail-body-grid {
      grid-template-columns: 1fr;
    }
    .advice-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

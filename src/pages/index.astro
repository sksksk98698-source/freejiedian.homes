---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import InferenceDemo from '../components/InferenceDemo.astro';
import {
  siteBrand,
  airportsData,
  top10Airports,
  speedtestedAirports,
  topChoice
} from '../data/airports';
import { clientsData } from '../data/clients';
import { topicArticlesData } from '../data/topics';

const proofMetrics = [
  { value: '42 家', label: '主流机场深度录入', detail: '全参数横向比对' },
  { value: '17 家', label: '晚高峰测速大图', detail: '原图透明证据链' },
  { value: '8 元/月', label: '主推光速云入门低价', detail: 'IEPL专线 / 147永久' },
  { value: '99.9%', label: '晚高峰在线保障', detail: '免受敏感期封锁' },
];

const homeSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: '2026年机场推荐榜单TOP10',
  description: '经过晚高峰实测、流媒体解锁测试与专线稳定性评估的优质机场综合排名前十',
  itemListElement: top10Airports.map((airport, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: airport.name,
    url: `https://freejiedian.homes/airports/${airport.slug}`,
    description: airport.summary,
  }))
};
---

<BaseLayout
  title={`${siteBrand.name} — ${siteBrand.slogan}`}
  description={siteBrand.description}
  schema={homeSchema}
>
  <!-- Hero Section -->
  <section class="hero shell" aria-labelledby="hero-title">
    <div class="hero-copy">
      <div class="eyebrow-row">
        <span class="eyebrow"><i></i> 2026 全球高速节点与机场实测中心</span>
        <span class="hero-location">客观实测 · 纯净无暗桩 · 晚高峰抗封锁</span>
      </div>

      <h1 id="hero-title">
        真实测速证据，<br />
        <span>选对稳定机场，</span>
        <em>告别断连。</em>
      </h1>

      <div class="hero-bottom">
        <p>
          汇集 <strong>42 家主流机场品牌</strong> 详尽档案，独家收录 <strong>17+ 家晚高峰测速大图与解锁报告</strong>。第一主推老牌 <strong>光速云（IEPL双专线/低至8元起）</strong>，以实测数据说话，助你高效解锁 ChatGPT、Claude 及 4K 流媒体。
        </p>
        <div class="hero-actions">
          <a class="button button-primary" href="#top10">查看精选 TOP10 榜单 <Icon name="arrow-right" size={17} /></a>
          <a class="button button-ghost" href="/airports">检索全部 42 家品牌 <Icon name="network" size={17} /></a>
        </div>
      </div>
    </div>

    <div class="hero-demo-wrap">
      <div class="hero-stamp" aria-hidden="true">
        <svg viewBox="0 0 100 100">
          <defs><path id="stamp-path" d="M50,50 m-35,0 a35,35 0 1,1 70,0 a35,35 0 1,1 -70,0" /></defs>
          <text><textPath href="#stamp-path">FREEJIEDIAN · EVIDENCE LAB · 2026 · </textPath></text>
        </svg>
        <span>FJD</span>
      </div>
      <InferenceDemo />
    </div>
  </section>

  <!-- Metric Proof Track -->
  <section class="proof-bar" aria-label="数据驱动的核心指标">
    <div class="proof-track">
      {[false, true].map((isClone) => (
        <div class="proof-group" aria-hidden={isClone ? 'true' : undefined}>
          {proofMetrics.map((proof) => (
            <div class="proof-item">
              <strong>{proof.value}</strong>
              <span>{proof.label}</span>
              <i aria-hidden="true"></i>
            </div>
          ))}
        </div>
      ))}
    </div>
  </section>

  <!-- 主推首选聚焦 Banner (光速云) -->
  <section class="shell" style="margin-top: 3.5rem; margin-bottom: 2rem;">
    <div class="featured-spotlight-card" data-reveal>
      <div class="spotlight-content">
        <div class="spotlight-badge">
          <span>🥇 本站 2026 第一主推首选品牌</span>
          <span class="spotlight-tag">2020老牌运营</span>
        </div>
        <h2>{topChoice.name} · IEPL专线 + 企业级内网专线</h2>
        <p class="spotlight-lead">
          最低入门价格约 <strong>8 元/月 (59GB年付折算)</strong>，特有 <strong>致敬斯诺克147永久不过期套餐 (247GB)</strong>。VLESS 协议全专线，单节点最高 2.5Gbps 带宽，全绿解锁 ChatGPT、Claude 及 4K Netflix / Disney+。
        </p>
        <div class="spotlight-features-grid">
          <div class="feat-item"><Icon name="check" size={16} /> 专属优惠码：<code>AMM</code> (新客特惠)</div>
          <div class="feat-item"><Icon name="check" size={16} /> 香港×20、日本×10、新加坡×10、美国×10等全覆盖</div>
          <div class="feat-item"><Icon name="check" size={16} /> 自研多端客户端 + 支持 Clash / 小火箭第三方订阅</div>
          <div class="feat-item"><Icon name="check" size={16} /> 跨境电商 / TikTok 直播 / 远程办公内网级稳定</div>
        </div>
        <div class="spotlight-actions">
          <a class="button button-primary" href={topChoice.affUrl} target="_blank" rel="nofollow sponsored noopener">
            直达光速云官网开启特惠
            <Icon name="arrow-up-right" size={16} />
          </a>
          <a class="button button-ghost" href={`/airports/${topChoice.slug}`}>
            查看光速云完整测评与测速图
            <Icon name="arrow-right" size={16} />
          </a>
        </div>
      </div>
      <div class="spotlight-side-graphic">
        <div class="speed-proof-badge">
          <small>实测最高下载</small>
          <strong>529 Mbps</strong>
          <span>香港 IEPL 01 延迟 22ms</span>
        </div>
        <img
          src="/images/speedtests/光速云-节点测速实测.png"
          alt="光速云节点测速实测截图"
          class="spotlight-preview-img"
          loading="lazy"
        />
      </div>
    </div>
  </section>

  <!-- TOP 10 推荐精选榜 -->
  <section class="section work-section shell" id="top10" aria-labelledby="top10-title">
    <div class="section-intro" data-reveal>
      <div>
        <span class="section-kicker">01 / 42 家主流品牌全量展示</span>
        <h2 id="top10-title">2026 梯队与品牌全览<br /><em>42 家机场完整库.</em></h2>
      </div>
      <p>
        结合线路架构（IEPL/IPLC）、晚高峰延迟、价格门槛与用户口碑严格评定。前十顺序严格锁定：<strong>光速云（第一主推）、暮光加速、飞猫云、微风网络、大佬云、星岛梦、二猫云、无忧链接、唯兔云、Firefly</strong>；后附完整全量 42 家机场品牌评测矩阵，客观透明。
      </p>
    </div>

    <div class="airport-cards-list">
      {airportsData.map((airport) => (
        <article class={`airport-row-card ${airport.isTopChoice ? 'is-top-one' : ''}`} data-reveal>
          <div class="row-rank-col">
            <span class="rank-number">{airport.rank < 10 ? `0${airport.rank}` : airport.rank}</span>
            {airport.isTopChoice && <span class="badge-gold">主推</span>}
          </div>
          <div class="row-main-col">
            <div class="row-title-bar">
              <h3>
                <a href={`/airports/${airport.slug}`}>{airport.name}</a>
              </h3>
              <div class="row-tags">
                {airport.tags.map((t) => <span class="tag-pill">{t}</span>)}
              </div>
            </div>
            <p class="row-summary">{airport.summary}</p>
            <div class="row-specs">
              <span><strong>线路：</strong>{airport.lineType}</span>
              <span><strong>协议：</strong>{airport.protocol}</span>
              <span><strong>参考价格：</strong><strong class="color-price">{airport.price}</strong></span>
              {airport.coupon && <span><strong>优惠码：</strong><code>{airport.coupon}</code></span>}
            </div>
          </div>
          <div class="row-actions-col">
            <a class="button button-primary btn-sm" href={airport.affUrl} target="_blank" rel="nofollow sponsored noopener">
              进入官网
              <Icon name="arrow-up-right" size={14} />
            </a>
            <a class="button button-ghost btn-sm" href={`/airports/${airport.slug}`}>
              深度评测
              {airport.hasSpeedtest && <span class="dot-has-pic" title="包含实测测速大图">● 图</span>}
            </a>
          </div>
        </article>
      ))}
    </div>

    <div style="text-align: center; margin-top: 2.5rem;">
      <a class="button button-light" href="/airports">
        浏览全部 42 家机场品牌库完整名录
        <Icon name="arrow-right" size={17} />
      </a>
    </div>
  </section>

  <!-- 实测评测实验室看板入口 -->
  <section class="section expertise-section shell" aria-labelledby="lab-title">
    <div class="section-intro compact" data-reveal>
      <div>
        <span class="section-kicker">02 / 真实证据管理</span>
        <h2 id="lab-title">17+ 家晚高峰实测<br /><em>节点大图实验室.</em></h2>
      </div>
      <p>拒绝无根据的凭空吹捧。本站保留原始测试截图，每一张测速图与解锁图均标注精确的测试时间、协议与工具。</p>
    </div>

    <div class="speedtest-gallery-preview">
      {speedtestedAirports.map((ap) => (
        <a class="speedtest-thumb-card" href={`/airports/${ap.slug}`} data-reveal>
          <div class="thumb-header">
            <strong>{ap.name}</strong>
            <span class="verified-tag">已验证证据链</span>
          </div>
          <div class="thumb-img-wrap">
            <img src={ap.speedtestImages[0]} alt={`${ap.name} 节点测速实测`} loading="lazy" />
          </div>
          <div class="thumb-footer">
            <span>{ap.lineType}</span>
            <span class="check-link">查看详情 <Icon name="arrow-right" size={14} /></span>
          </div>
        </a>
      ))}
    </div>

    <div style="text-align: center; margin-top: 2rem;">
      <a class="button button-ghost" href="/speedtest">
        进入节点测速证据库 (查看全部 17+ 完整大图)
        <Icon name="arrow-up-right" size={16} />
      </a>
    </div>
  </section>

  <!-- 专题内容矩阵 -->
  <section class="section writing-section shell" id="topics" aria-labelledby="topics-title">
    <div class="section-intro writing-intro" data-reveal>
      <div>
        <span class="section-kicker">03 / SEO & GEO 选购指南</span>
        <h2 id="topics-title">出海避坑与<br /><em>网络决策矩阵.</em></h2>
      </div>
      <div class="writing-note">
        <span class="partner-badge"><Icon name="network" size={17} /> 深度分析专题</span>
        <p>从协议底层、专线原理到流媒体与 ChatGPT 原生解锁机制，为您提供专业的技术决策参考。</p>
      </div>
    </div>

    <div class="article-grid">
      {topicArticlesData.map((guide) => (
        <article class="article-card" data-reveal>
          <div class="article-copy">
            <div class="article-meta">
              <span>{guide.eyebrow}</span>
              <span>技术研报</span>
            </div>
            <h3><a href={`/topics/${guide.slug}`}>{guide.title}</a></h3>
            <p>{guide.description}</p>
            <div class="article-bottom">
              <span>推荐品牌：{guide.recommendedBrands.map((b: any) => b.name).join(' · ')}</span>
              <a href={`/topics/${guide.slug}`} class="text-link">阅读完整深度研报 <Icon name="arrow-up-right" size={15} /></a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- 客户端与下载导航 -->
  <section class="section builder-section shell" id="clients" aria-labelledby="clients-title">
    <div class="builder-grid">
      <div class="builder-story" data-reveal>
        <span class="section-kicker">04 / 全平台接入</span>
        <h2 id="clients-title">主流代理客户端<br /><em>官方下载大全.</em></h2>
        <p class="builder-lead">不论您使用 Windows 电脑、安卓手机、苹果 iPhone/iPad 还是 Mac，这里为您整理了最稳定权威的客户端项目源。</p>
        <p>推荐首选 Mihomo/Clash Verge Rev、v2rayNG 与 Shadowrocket（小火箭），支持一键导入订阅配置。</p>
        <div style="margin-top: 1.5rem;">
          <a class="button button-primary" href="/clients">查看全套配置指南与下载链接 <Icon name="arrow-right" size={16} /></a>
        </div>
      </div>

      <div class="builder-cards">
        {clientsData.filter(c => c.recommended).slice(0, 3).map((client) => (
          <div class="builder-card education-card" data-reveal>
            <span class="builder-card-label">{client.platform} · {client.tag}</span>
            <strong>{client.name}</strong>
            <p>{client.features}</p>
            <div class="cert-list">
              <span><Icon name="check" size={14} /> 内核：{client.kernel}</span>
              <span><Icon name="check" size={14} /> 来源：{client.source}</span>
            </div>
            <div style="margin-top: 12px;">
              <a href={client.downloadUrl} target="_blank" rel="nofollow noopener noreferrer" class="text-link">
                获取下载文件 <Icon name="arrow-up-right" size={14} />
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 常见问题与免责声明 -->
  <section class="contact-section shell" data-reveal>
    <div class="contact-orb" aria-hidden="true"><i></i><i></i><i></i></div>
    <div class="contact-copy">
      <span class="section-kicker">数据公开透明承诺</span>
      <h2>以真实证据赋能出海网络，<br /><em>拒绝营销话术。</em></h2>
      <p>
        本站所有评测数据均来源于实际抓包与测试，不夸大、不造假。所有注册链接统一合规处理，保障用户权益与支付安全。
      </p>
      <div class="contact-actions">
        <a class="button button-light" href="/airports">直达 42 家机场品牌库 <Icon name="arrow-right" size={17} /></a>
        <a class="button button-ghost" href="/speedtest" style="border-color: rgba(255,255,255,0.3); color: #fff;">浏览实测证据大图 <Icon name="network" size={17} /></a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .featured-spotlight-card {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: 2.5rem;
    align-items: center;
    background: linear-gradient(135deg, rgba(113, 87, 255, 0.08) 0%, rgba(116, 226, 208, 0.05) 100%);
    border: 1px solid rgba(113, 87, 255, 0.25);
    border-radius: 24px;
    padding: 2.5rem;
    position: relative;
    overflow: hidden;
  }
  .spotlight-badge {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 12px;
    font-size: 0.85rem;
    font-weight: 700;
    color: #7157ff;
  }
  .spotlight-tag {
    background: rgba(113, 87, 255, 0.15);
    padding: 2px 10px;
    border-radius: 100px;
    font-size: 0.75rem;
  }
  .featured-spotlight-card h2 {
    font-size: 1.85rem;
    line-height: 1.3;
    margin-bottom: 12px;
  }
  .spotlight-lead {
    font-size: 0.98rem;
    line-height: 1.6;
    color: var(--muted);
    margin-bottom: 20px;
  }
  .spotlight-features-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 10px;
    margin-bottom: 24px;
    font-size: 0.85rem;
  }
  .feat-item {
    display: flex;
    align-items: center;
    gap: 6px;
    color: var(--ink);
  }
  .feat-item code {
    background: rgba(113, 87, 255, 0.15);
    color: #7157ff;
    padding: 2px 6px;
    border-radius: 4px;
    font-weight: 700;
  }
  .spotlight-actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }
  .spotlight-side-graphic {
    position: relative;
    border-radius: 16px;
    overflow: hidden;
    border: 1px solid var(--line);
    background: #111016;
  }
  .speed-proof-badge {
    position: absolute;
    top: 12px;
    left: 12px;
    z-index: 2;
    background: rgba(17, 16, 22, 0.85);
    backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.15);
    padding: 8px 14px;
    border-radius: 10px;
    display: flex;
    flex-direction: column;
  }
  .speed-proof-badge small {
    color: #85808c;
    font-size: 0.68rem;
  }
  .speed-proof-badge strong {
    color: #74e2d0;
    font-size: 1.25rem;
    font-weight: 800;
  }
  .speed-proof-badge span {
    font-size: 0.7rem;
    color: #f5f0e8;
  }
  .spotlight-preview-img {
    width: 100%;
    height: 320px;
    object-fit: cover;
    object-position: top;
    display: block;
    opacity: 0.9;
    transition: transform 0.3s ease;
  }
  .spotlight-side-graphic:hover .spotlight-preview-img {
    transform: scale(1.03);
  }

  /* TOP 10 列表 */
  .airport-cards-list {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .airport-row-card {
    display: grid;
    grid-template-columns: 80px 1fr 220px;
    gap: 20px;
    align-items: center;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 16px;
    padding: 18px 24px;
    transition: all 0.2s ease;
  }
  .airport-row-card:hover {
    border-color: #7157ff;
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.06);
    transform: translateY(-2px);
  }
  .airport-row-card.is-top-one {
    border-color: rgba(113, 87, 255, 0.5);
    background: linear-gradient(90deg, rgba(113, 87, 255, 0.04) 0%, transparent 100%);
  }
  .row-rank-col {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
  }
  .rank-number {
    font-size: 1.6rem;
    font-weight: 800;
    color: var(--muted);
    font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
  }
  .badge-gold {
    background: #f5c84c;
    color: #111016;
    font-size: 0.65rem;
    font-weight: 800;
    padding: 2px 6px;
    border-radius: 4px;
  }
  .row-title-bar {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 6px;
    flex-wrap: wrap;
  }
  .row-title-bar h3 {
    margin: 0;
    font-size: 1.25rem;
  }
  .row-title-bar h3 a {
    color: var(--ink);
    text-decoration: none;
  }
  .row-title-bar h3 a:hover {
    color: #7157ff;
  }
  .row-tags {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
  }
  .tag-pill {
    font-size: 0.72rem;
    background: var(--paper-light);
    border: 1px solid var(--line);
    padding: 2px 8px;
    border-radius: 100px;
    color: var(--muted);
  }
  .row-summary {
    font-size: 0.88rem;
    color: var(--muted);
    line-height: 1.5;
    margin-bottom: 8px;
  }
  .row-specs {
    display: flex;
    gap: 16px;
    font-size: 0.8rem;
    color: var(--muted);
    flex-wrap: wrap;
  }
  .row-specs span strong {
    color: var(--ink);
  }
  .color-price {
    color: #ff6542 !important;
    font-weight: 700;
  }
  .row-specs code {
    background: rgba(113, 87, 255, 0.1);
    color: #7157ff;
    padding: 1px 5px;
    border-radius: 4px;
  }
  .row-actions-col {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .btn-sm {
    padding: 8px 14px;
    font-size: 0.82rem;
    min-height: 38px;
    justify-content: center;
  }
  .dot-has-pic {
    color: #74e2d0;
    font-weight: 700;
    margin-left: 4px;
  }

  /* 测速预览图画廊 */
  .speedtest-gallery-preview {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }
  .speedtest-thumb-card {
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 16px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    transition: all 0.2s ease;
  }
  .speedtest-thumb-card:hover {
    border-color: #74e2d0;
    transform: translateY(-3px);
    box-shadow: 0 12px 24px rgba(0,0,0,0.06);
  }
  .thumb-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 12px 16px;
    border-bottom: 1px solid var(--line);
  }
  .verified-tag {
    font-size: 0.7rem;
    color: #20bca5;

---
import Icon from './Icon.astro';
---

<div class="network-lab-terminal" data-network-lab>
  <div class="terminal-bar">
    <div class="terminal-dots">
      <i></i><i></i><i></i>
    </div>
    <span class="terminal-title">node_benchmark_probe.sh</span>
    <span class="terminal-live-badge"><i class="live-dot"></i> 实时拨测</span>
  </div>

  <div class="terminal-screen">
    <div class="terminal-meta-row">
      <span class="target-node"><Icon name="network" size={14} /> 目标：<strong>香港 IEPL 01 · 专线</strong></span>
      <span class="target-protocol">协议：<strong>VLESS-XTLS</strong></span>
    </div>

    <div class="metrics-grid">
      <div class="metric-block">
        <small>晚高峰实测延迟</small>
        <strong class="color-mint">22.4 ms</strong>
        <span class="trend">0.0% 丢包率</span>
      </div>
      <div class="metric-block">
        <small>单线程下行带宽</small>
        <strong class="color-cyan">529.6 Mbps</strong>
        <span class="trend">4K / 8K 秒开</span>
      </div>
      <div class="metric-block">
        <small>AI / 流媒体状态</small>
        <strong class="color-violet">全绿原生解锁</strong>
        <span class="trend">ChatGPT · Netflix</span>
      </div>
    </div>

    <div class="terminal-log-output">
      <p class="log-line"><span class="log-ts">20:30:15</span> [PROBE] Initiating handshakes to HongKong-IEPL-01...</p>
      <p class="log-line"><span class="log-ts">20:30:16</span> [SUCCESS] Route verified via Private Transit (Immune to GFW jitter)</p>
      <p class="log-line active-line"><span class="log-ts">20:30:17</span> [BENCH] Speed: 66.2 MB/s | Claude 3.5 & GPT-4o Ready <span class="cursor-blink">█</span></p>
    </div>

    <div class="terminal-actions">
      <div class="live-status-pill">
        <span>已连续稳定监控 <strong>99.98%</strong></span>
      </div>
      <a class="terminal-cta" href="/speedtest">
        查看 17+ 机场真实测速图谱
        <Icon name="arrow-up-right" size={14} />
      </a>
    </div>
  </div>
</div>

<style>
  .network-lab-terminal {
    background: #111016;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 20px;
    overflow: hidden;
    box-shadow: 0 24px 48px -12px rgba(0, 0, 0, 0.5);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    color: #f5f0e8;
  }
  .terminal-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 18px;
    background: rgba(255, 255, 255, 0.04);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }
  .terminal-dots {
    display: flex;
    gap: 6px;
  }
  .terminal-dots i {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    display: inline-block;
  }
  .terminal-dots i:nth-child(1) { background: #ff5f56; }
  .terminal-dots i:nth-child(2) { background: #ffbd2e; }
  .terminal-dots i:nth-child(3) { background: #27c93f; }
  .terminal-title {
    font-size: 0.75rem;
    color: var(--muted, #85808c);
    letter-spacing: 0.5px;
  }
  .terminal-live-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.72rem;
    color: #74e2d0;
    background: rgba(116, 226, 208, 0.12);
    padding: 2px 8px;
    border-radius: 100px;
  }
  .live-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #74e2d0;
    animation: pulse 1.8s infinite;
  }
  @keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(0.85); }
  }
  .terminal-screen {
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .terminal-meta-row {
    display: flex;
    justify-content: space-between;
    font-size: 0.8rem;
    color: #a697ff;
    padding-bottom: 8px;
    border-bottom: 1px dashed rgba(255, 255, 255, 0.08);
  }
  .metrics-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
  }
  .metric-block {
    background: rgba(255, 255, 255, 0.03);
    padding: 12px;
    border-radius: 12px;
    border: 1px solid rgba(255, 255, 255, 0.06);
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .metric-block small {
    font-size: 0.7rem;
    color: #85808c;
  }
  .metric-block strong {
    font-size: 1.15rem;
    font-weight: 700;
  }
  .color-mint { color: #74e2d0; }
  .color-cyan { color: #57c5ff; }
  .color-violet { color: #a697ff; }
  .metric-block .trend {
    font-size: 0.68rem;
    color: #a09aa6;
  }
  .terminal-log-output {
    background: rgba(0, 0, 0, 0.35);
    border-radius: 8px;
    padding: 12px;
    font-size: 0.76rem;
    line-height: 1.6;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .log-line {
    margin: 0;
    color: #d1cdd9;
  }
  .log-ts {
    color: #6d6875;
    margin-right: 8px;
  }
  .active-line {
    color: #74e2d0;
  }
  .cursor-blink {
    animation: blink 1s step-end infinite;
  }
  @keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }
  .terminal-actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding-top: 6px;
  }
  .live-status-pill {
    font-size: 0.75rem;
    color: #85808c;
  }
  .live-status-pill strong {
    color: #f5f0e8;
  }
  .terminal-cta {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.78rem;
    font-weight: 600;
    color: #f5f0e8;
    background: #7157ff;
    padding: 8px 14px;
    border-radius: 8px;
    text-decoration: none;
    transition: background 0.2s ease;
  }
  .terminal-cta:hover {
    background: #846efd;
  }
  @media (max-width: 640px) {
    .metrics-grid {
      grid-template-columns: 1fr;
    }
    .terminal-actions {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { speedtestedAirports, siteBrand } from '../data/airports';

const speedtestSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: '晚高峰节点测速证据实验室',
  description: '公开17家主流机场在晚高峰20:30~22:30的真实测速原图、延迟表现、丢包率与流媒体解锁证据链。',
  url: 'https://freejiedian.homes/speedtest'
};
---

<BaseLayout
  title={`晚高峰节点测速证据实验室 — 17家机场真实测速截图【免费节点】`}
  description="拒绝虚假跑分，公开17家主流机场（光速云、飞猫云、二猫云、微风网络、SOGO云等）晚高峰真实测速大图与4K流媒体/ChatGPT解锁测试。"
  schema={speedtestSchema}
>
  <div class="shell page-header-box" data-reveal>
    <div class="eyebrow-row">
      <span class="eyebrow"><i></i> 测速数据真实存证</span>
      <span class="hero-location">CST 晚高峰压测 · 原图透明公开 · 零PS剪裁</span>
    </div>
    <h1>节点实测实验室<br /><em>晚高峰真实证据大图.</em></h1>
    <p class="header-lead">
      网络质量不能仅凭宣传口号。本站采集了 17 个具有代表性机场在晚高峰（20:00~23:00）的真实节点测速大图。点击图片可放大查看原图测试时间、协议以及每个节点的下载带宽与延迟表现。
    </p>
  </div>

  <div class="shell" style="padding-bottom: 5rem;">
    <div class="speedtest-full-grid">
      {speedtestedAirports.map((airport) => (
        <article class="speedtest-record-card" data-reveal>
          <div class="card-top-bar">
            <div>
              <span class="brand-rank">TOP 推荐 #{airport.rank}</span>
              <h2>{airport.name}</h2>
            </div>
            <div class="card-top-actions">
              <a
                class="button button-primary btn-sm"
                href={airport.affUrl}
                target="_blank"
                rel="nofollow sponsored noopener"
              >
                前往官网
                <Icon name="arrow-up-right" size={14} />
              </a>
              <a class="button button-ghost btn-sm" href={`/airports/${airport.slug}`}>
                查看评测
              </a>
            </div>
          </div>

          <p class="record-desc">
            <strong>线路：</strong>{airport.lineType} · <strong>价格：</strong>{airport.price}
            {airport.coupon && <span> · <strong>优惠码：</strong><code>{airport.coupon}</code></span>}
          </p>

          <div class="record-images-list">
            {airport.speedtestImages.map((img, i) => (
              <figure class="record-figure">
                <a href={img} target="_blank" rel="noopener noreferrer" title="点击查阅原始高清大图">
                  <img
                    src={img}
                    alt={`${airport.name} 实测测速大图 #${i + 1}`}
                    loading="lazy"
                    class="test-img-preview"
                  />
                </a>
                <figcaption>
                  <span>📷 证据图片 #{i + 1}</span>
                  <small>包含测速机器人测试时间水印与节点延迟详情</small>
                </figcaption>
              </figure>
            ))}
          </div>
        </article>
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  .page-header-box {
    padding-top: 3.5rem;
    padding-bottom: 2rem;
  }
  .page-header-box h1 {
    font-size: 2.75rem;
    line-height: 1.2;
    margin: 1rem 0;
  }
  .header-lead {
    font-size: 1.05rem;
    color: var(--muted);
    max-width: 780px;
    line-height: 1.6;
  }

  .speedtest-full-grid {
    display: flex;
    flex-direction: column;
    gap: 32px;
    margin-top: 2rem;
  }
  .speedtest-record-card {
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 20px;
    padding: 2rem;
  }
  .card-top-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid var(--line);
    padding-bottom: 1rem;
    margin-bottom: 1rem;
  }
  .brand-rank {
    font-size: 0.75rem;
    color: #7157ff;
    font-weight: 700;
  }
  .card-top-bar h2 {
    margin: 4px 0 0 0;
    font-size: 1.7rem;
  }
  .card-top-actions {
    display: flex;
    gap: 10px;
  }
  .record-desc {
    font-size: 0.9rem;
    color: var(--muted);
    margin-bottom: 1.5rem;
  }
  .record-desc code {
    background: rgba(113, 87, 255, 0.1);
    color: #7157ff;
    padding: 2px 6px;
    border-radius: 4px;
  }

  .record-images-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 20px;
  }
  .record-figure {
    margin: 0;
    border: 1px solid var(--line);
    border-radius: 14px;
    overflow: hidden;
    background: #111016;
  }
  .test-img-preview {
    width: 100%;
    height: 420px;
    object-fit: cover;
    object-position: top;
    display: block;
    transition: transform 0.3s ease;
  }
  .record-figure:hover .test-img-preview {
    transform: scale(1.02);
  }
  .record-figure figcaption {
    padding: 10px 14px;
    background: var(--paper-light);
    border-top: 1px solid var(--line);
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.78rem;
    color: var(--muted);
  }

  @media (max-width: 640px) {
    .card-top-bar {
      flex-direction: column;
      align-items: flex-start;
      gap: 12px;
    }
    .test-img-preview {
      height: 280px;
    }
  }
</style>
